class Vector3ExE
{
public:
	Vector3ExE() : x(0.f), y(0.f), z(0.f), Enc()
	{

	}

	Vector3ExE(float _x, float _y, float _z , FEncHandler _Enc) : x(_x), y(_y), z(_z), Enc(_Enc)
	{

	}
	~Vector3ExE()
	{

	}

	float x;
	float y;
	float z;
	 FEncHandler  Enc;
	 
	inline float Dot(Vector3ExE v)
	{
		return x * v.x + y * v.y + z * v.z;
	}

	inline float Distance(Vector3ExE v)
	{
		return float(sqrtf(powf(v.x - x, 2.0) + powf(v.y - y, 2.0) + powf(v.z - z, 2.0)));
	}
	inline bool ChackLogic()
	{
	 
		float x_value_def = 1000.0, y_value_def = x_value_def*8 , z_value_def = x_value_def/8;
		if (x > x_value_def && y < -y_value_def && (z > z_value_def && z < x || z < -z_value_def)) return true; else return false;
		if (x< -x_value_def && y > y_value_def && (z < -z_value_def && -z< -x || z >z_value_def)) return true; else return false;

		if (x < -00.1 && y>00.1) return false; 
	}
	Vector3ExE operator+(Vector3ExE v)
	{
		return Vector3ExE(x + v.x, y + v.y, z + v.z, {});
	}

	Vector3ExE operator-(Vector3ExE v)
	{
		return Vector3ExE(x - v.x, y - v.y, z - v.z, {});
	}
	inline float Length()
	{
		return sqrtf((x * x) + (y * y) + (z * z));
	}



};
 

 class Vector3
{
public:
    float x, y, z;

    Vector3() : x(0.f), y(0.f), z(0.f) {}
    Vector3(float _x, float _y, float _z) : x(_x), y(_y), z(_z) {}

    // ---------------- Basic ----------------
    inline bool IsZero() const {
        return (fabs(x) < 1e-6f && fabs(y) < 1e-6f && fabs(z) < 1e-6f);
    }

    inline float Magnitude() const {
        return sqrtf(x * x + y * y + z * z);
    }

    inline float Length() const { return Magnitude(); }

    inline Vector3 GetNormalized() const {
        float len = Magnitude();
        if (len < 1e-6f) return Vector3(0,0,0);
        return Vector3(x / len, y / len, z / len);
    }

    // ---------------- Math ----------------
    inline float Dot(const Vector3& v) const {
        return x * v.x + y * v.y + z * v.z;
    }

    inline Vector3 Cross(const Vector3& v) const {
        return Vector3(
            y * v.z - z * v.y,
            z * v.x - x * v.z,
            x * v.y - y * v.x
        );
    }

    inline float Distance(const Vector3& v) const {
        return sqrtf((v.x - x) * (v.x - x) + (v.y - y) * (v.y - y) + (v.z - z) * (v.z - z));
    }

    inline float GetDistanceTo(const Vector3& v) const { 
        return (v - *this).Magnitude(); 
    }

    inline float GetDistanceToInMeters(const Vector3& v) const {
        return GetDistanceTo(v) * 0.01f;
    }

    // ---------------- Operators ----------------
    inline Vector3 operator+(const Vector3& v) const { return Vector3(x + v.x, y + v.y, z + v.z); }
    inline Vector3 operator-(const Vector3& v) const { return Vector3(x - v.x, y - v.y, z - v.z); }
    inline Vector3 operator*(float s) const { return Vector3(x * s, y * s, z * s); }
    inline Vector3 operator/(float s) const { return (s == 0) ? *this : Vector3(x / s, y / s, z / s); }

    inline Vector3& operator+=(const Vector3& v) { x += v.x; y += v.y; z += v.z; return *this; }
    inline Vector3& operator-=(const Vector3& v) { x -= v.x; y -= v.y; z -= v.z; return *this; }
    inline Vector3& operator*=(float s) { x *= s; y *= s; z *= s; return *this; }
    inline Vector3& operator/=(float s) { if (s != 0) { x /= s; y /= s; z /= s; } return *this; }

    inline bool operator==(const Vector3& v) const { return x == v.x && y == v.y && z == v.z; }
    inline bool operator!=(const Vector3& v) const { return !(*this == v); }

    // ---------------- Extra (ควรมีมากๆ) ----------------
    inline float Length2D() const {
        return sqrtf(x * x + y * y);
    }

    inline float Distance2D(const Vector3& v) const {
        float dx = v.x - x;
        float dy = v.y - y;
        return sqrtf(dx * dx + dy * dy);
    }
};
